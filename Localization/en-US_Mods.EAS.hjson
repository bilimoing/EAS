Items: {
	IchorStone: {
		Tooltip: Melee attacks inflict Ichor
		DisplayName: Ichor Stone
	}

	FrozenStone: {
		Tooltip: Melee attacks inflict Frozen flame
		DisplayName: Frozen Stone
	}

	CurseStone: {
		Tooltip: Melee attacks inflict Curse flame
		DisplayName: Curse Stone
	}

	IchorGloves: {
		DisplayName: Ichor Gauntlet
		Tooltip:
			'''
			Increases melee knockback and melee attacks inflict Ichor damage
			12% increased melee damage and speed
			Enables auto swing for melee weapons and whips
			Increases the size of melee weapons
			'''
	}

	CurseGloves: {
		DisplayName: Cursed Gauntlet
		Tooltip:
			'''
			Increases melee knockback and melee attacks inflict Curse flame damage
			12% increased melee damage and speed
			Enables auto swing for melee weapons and whips
			Increases the size of melee weapons
			'''
	}

	FrozenGloves: {
		DisplayName: Frozen Gauntlet
		Tooltip:
			'''
			Increases melee knockback and melee attacks inflict Frozen flame damage
			12% increased melee damage and speed
			Enables auto swing for melee weapons and whips
			Increases the size of melee weapons
			'''
	}

	IchorQuiver: {
		Tooltip:
			'''
			Increases arrow damage by 10% and greatly increases arrow speed
			20% chance not to consume arrows
			Lights wooden arrows ablaze
			'Quiver in fear!'
			'''
		DisplayName: Ichor Quiver
	}

	FrostfireQuiver: {
		Tooltip:
			'''
			Increases arrow damage by 10% and greatly increases arrow speed
			20% chance not to consume arrows
			Freezes wooden arrows
			'Quiver in fear!'
			'''
		DisplayName: Frostfire Quiver
	}

	CursedQuiver: {
		Tooltip:
			'''
			Increases arrow damage by 10% and greatly increases arrow speed
			20% chance not to consume arrows
			Curses wooden arrows
			'Quiver in fear!'
			'''
		DisplayName: Cursed Quiver
	}

	VenomStone: {
		Tooltip: Melee attacks inflict Venom
		DisplayName: Venom Stone
	}

	VenomQuiver: {
		Tooltip:
			'''
			Increases arrow damage by 10% and greatly increases arrow speed
			20% chance not to consume arrows
			Poisons wooden arrows
			'Quiver in fear!'
			'''
		DisplayName: Venom Quiver
	}

	VenomGloves: {
		Tooltip:
			'''
			Increases melee knockback and melee attacks inflict Venom damage
			12% increased melee damage and speed
			Enables auto swing for melee weapons and whips
			Increases the size of melee weapons
			'''
		DisplayName: Venom Gloves
	}

	DeathBone: {
		Tooltip:
			'''
			Summons tiny skeleton hands to attack enemies
			2 hands during daytime (double damage at night), 4 hands at night
			'''
		DisplayName: Death Bone
	}

	ObsidianScarf: {
		DisplayName: Obsidian Scarf
		Tooltip:
			'''
			Increased movement speed by 2%
			Immune lava
			Double tap in any direction to dash
			'''
	}

	LifeFlower: {
		DisplayName: Life Flower
		Tooltip: Automatically use health potions when needed
	}

	LifeCloak: {
		DisplayName: Life Cloak
		Tooltip:
			'''
			Automatically use health potions when needed
			Causes stars to fall after taking damage
			Stars restore mana when collected
			'''
	}

	FlowerFlower: {
		DisplayName: Flower Flower
		Tooltip:
			'''
			8% reduced mana usage
			Increases damage protection by 8%
			Automatically use health and mana potions when needed
			You feel the sight deep in the earth
			You feel your body getting colder and colder
			The jungle is closing in
			You lost your gold medal
			You feel miserable
			The eyes of cold and unfeeling look upon you
			Flower Flower is coming...
			'''
	}

	OilBarrel: {
		DisplayName: Oil Barrel
		Tooltip:
			'''
			Melee and ranged attacks will cover enemies with oil
			Covered enemies on fire will deal additional damage
			'''
	}

	BoilingWaterBottle: {
		DisplayName: Boiling Water
		Tooltip: Increase movement speed, defense and breathing time in the water
	}

	BottledShimmer: {
		DisplayName: Bottled Shimmer
		Tooltip:
			'''
			Grants luck while equipped
			Slightly increases all damage while inside shimmer liquid
			'''
	}

	FuzzyHandcuffs: {
		DisplayName: Fuzzy Handcuffs
		Tooltip:
			'''
			+30% whip range
			+15% whip attack speed
			'''
	}
}

