Items: {
	IchorStone: {
		Tooltip: 近战攻击造成灵液
		DisplayName: 灵液石
	}

	FrozenStone: {
		Tooltip: 近战攻击造成霜焰
		DisplayName: 极寒石
	}

	CurseStone: {
		Tooltip: 近战攻击造成诅咒焰
		DisplayName: 诅咒石
	}

	IchorGloves: {
		DisplayName: 灵液手套
		Tooltip:
			'''
			提高近战击退，近战攻击造成灵液
			近战伤害和近战速度各提高12%
			近战武器和鞭子可自动挥舞
			加大近战武器的尺寸
			'''
	}

	CurseGloves: {
		DisplayName: 诅咒手套
		Tooltip:
			'''
			提升近战击退力，近战攻击造成诅咒焰
			近战伤害和近战速度各提高12%
			近战武器和鞭子可自动挥舞
			加大近战武器的尺寸
			'''
	}

	FrozenGloves: {
		DisplayName: 极寒手套
		Tooltip:
			'''
			提升近战击退力，近战攻击造成霜焰
			近战伤害和近战速度各提高12%
			近战武器和鞭子可自动挥舞
			加大近战武器的尺寸
			'''
	}

	IchorQuiver: {
		Tooltip:
			'''
			箭的伤害提高10%，箭的速度大大提高
			20%几率不消耗箭
			点燃木箭，火光熊熊
			“在恐惧中颤抖吧！”
			'''
		DisplayName: 灵液箭袋
	}

	FrostfireQuiver: {
		Tooltip:
			'''
			箭的伤害提高10%，箭的速度大大提高
			20%几率不消耗箭
			冻结木箭，冰光闪闪
			“在恐惧中颤抖吧！”
			'''
		DisplayName: 极寒箭袋
	}

	CursedQuiver: {
		Tooltip:
			'''
			箭的伤害提高10%，箭的速度大大提高
			20%几率不消耗箭
			诅咒木箭，暗光闪闪
			“在恐惧中颤抖吧！”
			'''
		DisplayName: 诅咒箭袋
	}

	VenomStone: {
		Tooltip: 近战攻击造成毒液
		DisplayName: 毒液石
	}

	VenomQuiver: {
		Tooltip:
			'''
			箭的伤害提高10%，箭的速度大大提高
			20%几率不消耗箭
			毒液木箭，毒性弥漫
			“在恐惧中颤抖吧！”
			'''
		DisplayName: 毒液箭袋
	}

	VenomGloves: {
		Tooltip:
			'''
			提升近战击退力，近战攻击造成毒液
			近战伤害和近战速度各提高12%
			近战武器和鞭子可自动挥舞
			加大近战武器的尺寸
			'''
		DisplayName: 毒液手套
	}

	DeathBone: {
		Tooltip:
			'''
			召唤小骷髅手攻击敌人
			白天2个（双倍伤害），晚上4个
			'''
		DisplayName: 死亡之骨
	}

	ObsidianScarf: {
		DisplayName: 黑曜石围巾
		Tooltip:
			'''
			增加2%移动速度
			免疫岩浆
			双击冲刺
			'''
	}

	LifeFlower: {
		DisplayName: 生命花
		Tooltip: 在需要时自动使用生命药水
	}

	LifeCloak: {
		DisplayName: 生命斗篷
		Tooltip:
			'''
			需要时自动使用生命药水
			受到伤害后会使星星坠落
			收集星星会恢复魔力
			'''
	}

	FlowerFlower: {
		DisplayName: 花花
		Tooltip:
			'''
			减少8%的魔力消耗
			增加8%免伤效果
			在需要时自动使用生命和魔力药水
			今晚将是一个杀戮之夜
			你感受到地底深处的视线
			你觉得身体变得越来越冷
			丛林正在逐步逼近
			你失去了金牌
			你感到痛苦不堪
			冷漠无情的视线在你身上审视
			花花即将到来……
			'''
	}

	OilBarrel: {
		DisplayName: 石油桶
		Tooltip:
			'''
			近战和远程攻击将使敌人全身覆盖油
			覆盖油的敌人着火会额外造成伤害
			'''
	}

	BoilingWaterBottle: {
		DisplayName: 沸腾的水
		Tooltip: 在水中增加移动速度，防御和呼吸时间
	}

	BottledShimmer: {
		DisplayName: 瓶中微光
		Tooltip:
			'''
			装备时提供运气加成
			在微光环境下，小幅提升所有伤害
			'''
	}

	FuzzyHandcuffs: {
		DisplayName: 绒毛手铐
		Tooltip:
			'''
			增加30%鞭子攻击范围
			增加15%鞭子攻击速度
			'''
	}

	TerrapinEmblem: {
		DisplayName: 巨龟徽章
		Tooltip: 近战伤害提高20%
	}

	TerrapinEmblem2: {
		DisplayName: 冰龟徽章
		Tooltip:
			'''
			近战伤害提高30%
			生命值低于50%时，在持有者周围放置可降低25%伤害的护罩
			'''
	}
}

